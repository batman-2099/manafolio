# Dependencies are installed inside the image (npm ci); never copy host ones —
# they may be the wrong arch (native sqlite3) and bloat the build context.
node_modules
**/node_modules

# Build output (frontend is rebuilt in stage 1)
dist
**/dist
build
out

# VCS / CI
.git
.github
.gitignore
.gitattributes
.gitmodules

# Local build/cache artifacts and test output that are never used by the image.
.cache
**/.cache
coverage
**/coverage
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases and env — must not leak into the image
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
backend/database
.env
.env.*
# Per-user credentials may live beside a custom DB_PATH.
**/codex

# Logs and editor cruft
*.log
logs
.vscode
.idea
.DS_Store

# Agent / docs not needed at runtime
CLAUDE.md
