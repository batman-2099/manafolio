# Manafolio Environment Configuration Example

# The port the API and web app will be served on inside the container/local machine
PORT=3001

# Optional: also serve the SAME app over HTTPS on this port (the Docker image
# defaults it to 3443; a downloaded/local server leaves it off). Both ports serve
# identical content — HTTP is what you point a reverse proxy at, HTTPS is what you
# use directly when there is no proxy. Card scanning needs it: browsers only allow
# camera access in a secure context, so http://<lan-ip>:3001 can't scan while
# https://<lan-ip>:3443 can. Unset = HTTP only.
HTTPS_PORT=

# Optional: your own certificate for that HTTPS port. With both unset, a
# self-signed certificate is generated next to the database on first start and
# reused after (browsers show a one-time "unknown issuer" warning to click past).
SSL_CERT_PATH=
SSL_KEY_PATH=

# Optional database override. Unset uses backend/database/manafolio.db regardless
# of the working directory (Docker supplies /app/database/manafolio.db).
# Prefer an absolute path; relative overrides remain relative to the working directory.
# The rebuildable daily Scryfall import catalog is stored alongside this file
# as <DB_PATH>.scryfall-bulk.sqlite (reserve space for an atomic replacement).
# Admin Settings → Scryfall bulk data controls the daily UTC refresh (default 10:00).
# The time is saved in the application database, not an environment variable.
# Scheduled checks download changed snapshots only; Download now forces a redownload.
# DB_PATH=/absolute/path/to/manafolio.db

# Optional: default Ollama service for AI decks when a user's Settings address is
# blank. Users may enter their own address; Manafolio never downloads models or falls back to ChatGPT.
# HTTP(S) only, no credentials/query/fragment; redirects are not followed.
# In Docker, localhost means the container: see README for host-gateway setup.
# Members can contact server-accessible services: invite trusted users and restrict outbound access.
OLLAMA_BASE_URL=http://127.0.0.1:11434


# Comma-separated list of origins allowed to call the API (CORS). Defaults to
# the Vite dev server + same-origin production. Set this to your real domain
# when deploying somewhere other than localhost.
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Optional: the canonical externally-reachable URL for this instance, used to
# build collection share links. Set this when running behind a reverse proxy
# where the browser's own origin (protocol+host) isn't the address others
# should use to reach your share links, e.g. https://cards.example.com
# Can also be overridden later by an admin from the Admin Panel without
# redeploying.
PUBLIC_BASE_URL=

# Optional: create the "admin" account with this password when no users exist.
# If unset, open the web UI to create the owner account on first visit.
# Protect access until setup is complete. Passwords are not printed to logs.
DEFAULT_ADMIN_PASSWORD=

# Open self-registration. Default (unset/false) = invite-only: only an admin can
# create accounts (Admin panel). Set to "true" to let anyone self-register a
# member account from the login screen.
ALLOW_REGISTRATION=

# Set this when the app runs behind a reverse proxy that terminates TLS
# (nginx/Traefik/Caddy). Makes req.ip and the rate limiters use the real client
# IP from X-Forwarded-For. Use the number of proxy hops in front of the app
# (usually "1"), or "true". Leave UNSET when the app is directly exposed —
# trusting the header otherwise lets clients spoof their IP past the rate limiter.
TRUST_PROXY=

# Optional: automatic database snapshots, written to a backups/ folder next to
# the database. Hours between snapshots (default 24; 0 disables) and how many of
# the newest snapshots to keep (default 10).
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_LAST=10

# Optional: after the weekly set refresh finds new releases, scan catalogs that
# are already installed are rebuilt automatically. Set to 0 to disable.
# CATALOG_AUTO_UPDATE=0

# Optional: single sign-on through an OpenID Connect provider. Register
# <your address>/api/auth/oidc/callback as the redirect URI at the provider.
# "true" or "1" enables it; the issuer URL and client ID are then required.
# OIDC_ENABLED=true
# Issuer base URL; discovery is read from <issuer>/.well-known/openid-configuration.
# Must be https (plain http is accepted for localhost only).
# OIDC_ISSUER_URL=https://idp.example.com
# OIDC_CLIENT_ID=
# Required unless OIDC_TOKEN_ENDPOINT_AUTH_METHOD is "none".
# OIDC_CLIENT_SECRET=
# Client authentication at the token endpoint: client_secret_basic (default),
# client_secret_post, or none.
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
# Callback URL override. Default: PUBLIC_BASE_URL + /api/auth/oidc/callback, or
# the address of the incoming request when PUBLIC_BASE_URL is unset.
# OIDC_REDIRECT_URI=https://cards.example.com/api/auth/oidc/callback
# Scopes requested from the provider (default "openid profile email").
# OIDC_SCOPES=openid profile email
# Claim used as the Manafolio username (default preferred_username).
# OIDC_USER_CLAIM=preferred_username
# Provider name shown on the login button (default "Single Sign-On").
# OIDC_PROVIDER_NAME=Single Sign-On
# Create a Manafolio account on a new identity's first sign-in. On by default;
# "false" or "0" disables it unless ALLOW_REGISTRATION=true.
# OIDC_AUTO_PROVISION=true
# Role for auto-provisioned accounts: member (default) or admin.
# OIDC_DEFAULT_ROLE=member
# "true" or "1" lets an identity attach to an existing account with the same
# username. Off by default: enable it only when users cannot choose their own
# username at the provider, or anyone naming themselves "admin" there signs in
# as the owner.
# OIDC_ALLOW_USERNAME_LINK=true
# Secret that signs in-flight login state. Unset = random on every server start.
# OIDC_SESSION_SECRET=
